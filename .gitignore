# Data storage (Raw and Snapshots MUST NEVER be committed to Git)
data/raw/**
!data/raw/.gitkeep
data/snapshots/**
!data/snapshots/.gitkeep
data/processed/**

# Execution Logs
logs/**
!logs/.gitkeep

