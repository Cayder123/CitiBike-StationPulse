# Environment Variables Template
# Copy to .env and adjust as necessary for your local workstation

# Project Paths
STATIONPULSE_RAW_ROOT=data/raw
STATIONPULSE_SNAPSHOTS_ROOT=data/snapshots
STATIONPULSE_LOGS_ROOT=logs

# Network & Download Limits
STATIONPULSE_DOWNLOAD_TIMEOUT=30
STATIONPULSE_MAX_DOWNLOAD_MB=500
STATIONPULSE_MAX_RETRIES=3
STATIONPULSE_RETRY_BACKOFF_FACTOR=2.0

# Official Feed URLs (Can be overridden if needed)
STATIONPULSE_GBFS_ROOT_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
STATIONPULSE_TRIPDATA_BASE_URL=https://s3.amazonaws.com/tripdata

# PySpark Local Tuning
SPARK_LOCAL_IP=127.0.0.1
PYSPARK_SUBMIT_ARGS=--driver-memory 2g pyspark-shell
